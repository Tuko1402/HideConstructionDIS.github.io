  <header class="top">
    <svg class="contour" viewBox="0 0 320 220" fill="none" stroke="#ffffff" stroke-width="1.5" aria-hidden="true">
      <ellipse cx="200" cy="100" rx="40" ry="26"></ellipse><ellipse cx="200" cy="100" rx="70" ry="46"></ellipse>
      <ellipse cx="200" cy="100" rx="100" ry="66"></ellipse><ellipse cx="200" cy="100" rx="130" ry="86"></ellipse>
      <ellipse cx="200" cy="100" rx="160" ry="106"></ellipse>
