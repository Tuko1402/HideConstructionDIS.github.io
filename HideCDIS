    (rec.photo ? '<button class="btn small" type="button" data-act="rmphoto">Remove</button>' : '') +
    '</span></figcaption><input type="file" id="file" accept="image/*" hidden></figure>';

  var progressWidget = '<div class="progress-card"><div class="progress-card-head"><span class="progress-card-title">' + ic('pct', 18) + 'Overall Construction Completion</span>' +
    renderPctDropdown(rec, 'f-pct-widget') + '</div>' + renderProgressBar(rec.percentage) + '</div>';

  var map = '<div class="mapbox"><span class="k">Location Map</span>' +
    '<a class="mapcard" href="' + mapUrl(rec) + '" target="_blank" rel="noopener noreferrer">' + MAP_ART +
    '<span class="mapcard-text"><span class="dot">' + ic('pin', 20) + '</span><div><strong>Open in Google Maps</strong><small>' + esc(rec.location) + '</small></div>' + ic('ext', 18) + '</span></a>' +
    '<a class="btn" href="' + dirUrl(rec) + '" target="_blank" rel="noopener noreferrer">' + ic('route', 16) + 'Get Directions</a></div>';

  var secs = SECTIONS.map(function (s) {
    var rows = s.fields.map(function (k) {
      var f = FIELDS[k], wide = f.kind === 'textarea';
      if (!e && wide && (rec[k] === '' || rec[k] == null)) {
        return '<div class="row wide"><dt class="k sr">' + esc(f.label) + '</dt><dd><span class="none">No remarks.</span></dd></div>';
      }
      return '<div class="row' + (wide ? ' wide' : '') + '"><dt class="k' + (wide && !e ? ' sr' : '') + '">' +
        (e ? '<label for="f-' + k + '">' + esc(f.label) + '</label>' : esc(f.label)) + '</dt><dd>' +
        (e ? control(rec, k, 'f-' + k) : display(rec, k)) + '</dd></div>';
    }).join('');
    return '<section class="sec"><h2><span class="dot">' + ic(s.icon, 18) + '</span>' + esc(s.title) +
      (s.rating ? pill('rating', rating(rec)) : '') + '</h2><dl class="fields">' + rows + '</dl></section>';
  }).join('');

  var visitsList = rec.visits || [];
  var visitsCardsHtml = visitsList.length === 0 ? '<p class="none" style="padding:16px; text-align:center;">No site visits logged yet.</p>' :
    '<div class="visits-grid">' + visitsList.map(function (v, idx) {
      return '<div class="visit-card">' +
        '<div class="visit-img">' + (v.photo ? '<img src="' + esc(v.photo) + '" alt="Visit photo">' : ic('camera', 32)) + '</div>' +
        '<div class="visit-body">' +
          '<div class="visit-date"><span>' + ic('calendar', 14) + ' ' + dateText(v.date) + '</span>' + pill('status', v.percentage + '%') + '</div>' +
          '<p class="visit-eval">' + esc(v.evaluation || 'No evaluation noted.') + '</p>' +
          (e ? '<button class="btn small danger" type="button" data-act="delvisit" data-vidx="' + idx + '">Delete Log</button>' : '') +
        '</div>' +
      '</div>';
    }).join('') + '</div>';

  var visitsSection = '<section class="sec visits-sec">' +
    '<div class="visits-head"><h2><span class="dot">' + ic('camera', 18) + '</span>Site Visits & Progress Log</h2>' +
    '<button class="btn primary small" type="button" data-act="toggle-add-visit">' + ic('plus', 14) + 'Log New Visit</button></div>' +
    '<div id="addVisitBox" class="add-visit-box" hidden>' +
      '<strong>Log Site Visit & Inspection Evaluation</strong>' +
      '<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap:10px;">' +
        '<div><label class="k" for="vdate">Visit Date</label><input type="date" id="vdate" class="in" value="' + new Date().toISOString().split('T')[0] + '"></div>' +
        '<div><label class="k" for="vpct">Recorded Progress (%)</label>' +
          '<select id="vpct" class="in">' + OPTIONS.percentages.map(function(p){ return '<option value="' + p + '">' + p + '%</option>'; }).join('') + '</select></div>' +
      '</div>' +
      '<div><label class="k" for="veval">Evaluation / Remarks</label><textarea id="veval" class="in" rows="2" placeholder="Site observations, work accomplished..."></textarea></div>' +
      '<div><label class="k" for="vphoto">Visit Photo</label><input type="file" id="vphoto" class="in" accept="image/*"></div>' +
      '<div style="display:flex; gap:8px;"><button class="btn primary small" type="button" data-act="savevisit">Save Visit Record</button>' +
      '<button class="btn small" type="button" data-act="toggle-add-visit">Cancel</button></div>' +
    '</div>' +
    visitsCardsHtml + '</section>';

  var foot = '<footer class="cardfoot">' +
    (prev ? '<a class="btn" href="' + hashFor(prev.id) + '">' + ic('left', 16) + '<span class="mono">' + esc(prev.id) + '</span></a>' : '<span></span>') +
    (next ? '<a class="btn" href="' + hashFor(next.id) + '"><span class="mono">' + esc(next.id) + '</span>' + ic('right', 16) + '</a>' : '<span></span>') +
    '</footer>';

  app.innerHTML =
    '<div class="topnav"><a class="btn primary" href="#inventory">' + ic('left', 16) + 'Back to Main Overview</a></div>' +
    '<article class="card">' + head + '<div class="detail"><div class="left"><section aria-label="Photo">' + photo + '</section>' + progressWidget + map +
    '</div><div class="right">' + secs + visitsSection + '</div></div>' + foot + '</article>';
}

function fileToDataUrl(file) {
  return new Promise(function (resolve, reject) {
    var fr = new FileReader();
    fr.onerror = reject;
    fr.onload = function () {
      var img = new Image();
      img.onerror = reject;
      img.onload = function () {
        var s = Math.min(1, 1000 / Math.max(img.width, img.height));
        var c = document.createElement('canvas');
        c.width = Math.round(img.width * s);
        c.height = Math.round(img.height * s);
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
        resolve(c.toDataURL('image/jpeg', 0.80));
      };
      img.src = fr.result;
    };
    fr.readAsDataURL(file);
  });
}
function currentRecord() {
  var h = location.hash.slice(1);
  if (h.indexOf('record-') !== 0) return null;
  var s = h.slice(7);
  return records.filter(function (r) { return slugOf(r.id) === s; })[0] || null;
}
function setPhoto(file) {
  var rec = currentRecord();
  if (!rec || !file) return;
  if (!/^image\//.test(file.type)) { toast('Please select an image file.'); return; }
  fileToDataUrl(file).then(function (url) {
    rec.photo = url;
    save(); viewDetail(rec); toast('Photo updated.');
  }).catch(function () { toast('Failed to read image.'); });
}

function copyJson() {
  var out = JSON.stringify(records.map(function (r) {
    var c = Object.assign({}, r);
    if (String(c.photo || '').indexOf('data:') === 0) c.photo = '';
    return c;
  }), null, 2);
  try {
    navigator.clipboard.writeText(out).then(function () { toast('JSON data copied to clipboard.'); });
  } catch (err) { toast('Could not copy automatically.'); }
}
function addRecord() {
  var nums = records.map(function (r) { var m = String(r.id).match(/(\d{4})$/); return m ? Number(m[1]) : 0; });
  var id = ID_PREFIX + String(Math.max.apply(null, [0].concat(nums)) + 1).padStart(4, '0');
  records.push({ id: id, name: 'New Construction Project', location: 'Davao City', percentage: 10, mapQuery: '', region: 'Region XI', group: OPTIONS.group[0], status: OPTIONS.status[0], photo: '', visits: [] });
  save(); state.q = ''; viewMaster(); toast('Added ' + id);
}
function armed(btn, label, run) {
  if (btn.dataset.armed) { run(); return; }
  btn.dataset.armed = '1'; btn.textContent = 'Click to confirm';
  setTimeout(function () { if (btn.isConnected) { delete btn.dataset.armed; btn.textContent = label; } }, 3000);
}

function route(initial) {
  var rec = currentRecord();
  if (rec) viewDetail(rec); else viewMaster();
  if (!initial) { window.scrollTo(0, 0); }
}
window.addEventListener('hashchange', function () { route(false); });

document.getElementById('editToggle').addEventListener('click', function () {
  state.editing = !state.editing;
  this.setAttribute('aria-pressed', String(state.editing));
  document.getElementById('editLabel').textContent = 'Edit mode: ' + (state.editing ? 'on' : 'off');
  route(true);
});

document.addEventListener('input', function (ev) {
  var t = ev.target;
  if (t.id === 'q') { state.q = t.value; updateRows(); return; }
  if (!t.dataset || !t.dataset.key) return;
  var rec = records.filter(function (r) { return r.id === t.dataset.id; })[0];
  if (!rec) return;
  var key = t.dataset.key, f = FIELDS[key], v = t.value;
  if (key === 'percentage') v = parseInt(v, 10) || 0;
  rec[key] = v;
  save();
});

document.addEventListener('change', function (ev) {
  var t = ev.target;
  if (t.id === 'file') { setPhoto(t.files[0]); t.value = ''; }
  if (t.dataset && t.dataset.key === 'percentage') {
    var rec = records.filter(function (r) { return r.id === t.dataset.id; })[0];
    if (rec) {
      rec.percentage = parseInt(t.value, 10) || 0;
      save();
      var current = currentRecord();
      if (current && current.id === rec.id) { viewDetail(rec); }
      toast('Progress updated to ' + t.value + '%');
    }
  }
});

document.addEventListener('click', function (ev) {
  var btn = ev.target.closest('[data-act]');
  if (!btn) return;
  var act = btn.dataset.act;
  if (act === 'add') addRecord();
  else if (act === 'copy') copyJson();
  else if (act === 'pick') document.getElementById('file').click();
  else if (act === 'rmphoto') {
    var rec = currentRecord();
    if (rec) { rec.photo = ''; save(); viewDetail(rec); toast('Photo removed.'); }
  } else if (act === 'del') {
    armed(btn, 'Delete', function () {
      var id = btn.dataset.id;
      records = records.filter(function (r) { return r.id !== id; });
      save(); updateRows(); toast('Deleted ' + id);
    });
  } else if (act === 'reset') {
    armed(btn, 'Reset Data', function () {
      try { localStorage.removeItem(STORE_KEY); } catch (e) {}
      records = clone(DATA); state.q = ''; viewMaster(); toast('Restored default records.');
    });
  } else if (act === 'toggle-add-visit') {
    var box = document.getElementById('addVisitBox');
    if (box) box.hidden = !box.hidden;
  } else if (act === 'savevisit') {
    var rec = currentRecord();
    if (!rec) return;
    var vdate = document.getElementById('vdate').value;
    var vpct = parseInt(document.getElementById('vpct').value, 10) || 0;
    var veval = document.getElementById('veval').value;
    var vphotoFile = document.getElementById('vphoto').files[0];

    var newVisit = { id: 'v_' + Date.now(), date: vdate, percentage: vpct, evaluation: veval, photo: '' };
    var finalize = function() {
      if (!rec.visits) rec.visits = [];
      rec.visits.unshift(newVisit);
      rec.percentage = vpct;
      save();
      viewDetail(rec);
      toast('Site visit logged & percentage updated!');
    };

    if (vphotoFile) {
      fileToDataUrl(vphotoFile).then(function(url){
        newVisit.photo = url;
        finalize();
      }).catch(finalize);
    } else {
      finalize();
    }
  } else if (act === 'delvisit') {
    var rec = currentRecord();
    var idx = parseInt(btn.dataset.vidx, 10);
    if (rec && rec.visits && !isNaN(idx)) {
      rec.visits.splice(idx, 1);
      save();
      viewDetail(rec);
      toast('Visit log removed.');
    }
  }
});

route(true);
})();
</script>
</body></html>
