}

function control(r, key, uid) {
  var f = FIELDS[key], v = r[key];
  if (key === 'percentage') return renderPctDropdown(r, uid);
  var common = (uid ? 'id="' + uid + '" ' : '') + 'class="in" data-id="' + esc(r.id) + '" data-key="' + key + '" aria-label="' + esc(f.label) + ' for ' + esc(r.id) + '"';
  if (f.kind === 'select') {
    var opts = f.options.indexOf(v) >= 0 || v === '' || v == null ? f.options : [v].concat(f.options);
    return '<select ' + common + '>' + opts.map(function (o) {
      return '<option' + (o === v ? ' selected' : '') + '>' + esc(o) + '</option>';
    }).join('') + '</select>';
  }
  if (f.kind === 'textarea') return '<textarea ' + common + ' rows="4">' + esc(v == null ? '' : v) + '</textarea>';
  var mode = (f.kind === 'money' || f.kind === 'area' || f.kind === 'perarea' || f.kind === 'int') ? ' inputmode="decimal"' : '';
  return '<input ' + common + ' type="text"' + mode + ' value="' + esc(v == null ? '' : v) + '">';
}

function display(r, key) {
  var f = FIELDS[key], v = r[key];
  if (key === 'percentage') return renderProgressBar(v);
  if (v === '' || v == null) return '<span class="none">—</span>';
  if (typeof v === 'string' && v.trim().toUpperCase() === 'N/A') return '<span class="none">N/A</span>';
  switch (f.kind) {
    case 'money':    return isNum(v) ? '<span class="num">' + peso(v) + '</span>' : esc(v);
    case 'area':     return isNum(v) ? '<span class="num">' + v.toLocaleString('en-PH') + ' sq m</span>' : esc(v);
    case 'perarea':  return isNum(v) ? '<span class="num">' + peso(v) + ' per sq m</span>' : esc(v);
    case 'int':      return isNum(v) ? '<span class="num">' + v.toLocaleString('en-PH') + '</span>' : esc(v);
    case 'date':     return '<span class="num">' + dateText(v) + '</span>';
    case 'textarea': return '<p class="remark">' + esc(v) + '</p>';
  }
  if (TONES[key]) return pill(key, v);
  return esc(v);
}

