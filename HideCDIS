function esc(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}
function slugOf(id) { return String(id).toLowerCase().replace(/[^a-z0-9]/g, ''); }
function hashFor(id) { return '#record-' + slugOf(id); }
function isNum(v) { return typeof v === 'number' && isFinite(v); }
function peso(n) {
  try { return new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP', minimumFractionDigits: 0, maximumFractionDigits: 2 }).format(n); }
  catch (e) { return '₱' + n.toLocaleString(); }
}
function dateText(v) {
  var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(v);
  if (!m) return esc(v);
  return new Date(+m[1], +m[2] - 1, +m[3]).toLocaleDateString('en-PH', { year: 'numeric', month: 'short', day: 'numeric' });
}
function kw(s) { return '<span class="kw">' + s + '</span>'; }
function toast(m) {
