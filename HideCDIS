    <div class="brand">
      <span class="brand-mark" id="brandMark"></span>
      <div>
        <div class="brand-name">HIDE Construction Database Inventory System</div>
        <div class="brand-sub">Mapua Malayan Colleges Mindanao</div>
      </div>
